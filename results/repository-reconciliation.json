      {
        "name": "Audit every new declaration dependency closure",
        "command": "python3 - <<'PY'\nimport hashlib, json, re, subprocess\nfrom pathlib import Path\ninputs = [\n    ('Subtail/TerminalRealization.lean', 'Subtail.TerminalRealization'),\n    ('Subtail/TerminalRealizationModel.lean', 'Subtail.TerminalRealization'),\n    ('Subtail/TerminalRealizationAudit.lean', 'Subtail.TerminalRealization.Audit'),\n]\nnames, hashes = [], {}\nfor filename, prefix in inputs:\n    source = Path(filename).read_text()\n    hashes[filename] = hashlib.sha256(source.encode()).hexdigest()\n    names += [prefix + '.' + n for n in re.findall(\n        r'^(?:@\\[[^\\n]+\\]\\s*)?(?:def|theorem)\\s+(\\w+)', source, re.M)]\naudit = Path('_C030DependencyAudit.lean')\naudit.write_text('import Subtail.TerminalRealizationAudit\\n' +\n                 '\\n'.join('#print axioms ' + n for n in names) + '\\n')\ntext = subprocess.check_output(['lake', 'env', 'lean', str(audit)], text=True, timeout=120)\nprint(text)\nentries = re.findall(r\"'([^']+)' (?:depends on axioms: \\[([^\\]]*)\\]|does not depend on any axioms)\", text)\nfound = {name: set(filter(None, (a.strip() for a in axioms.split(','))))\n         for name, axioms in entries}\nif set(found) != set(names):\n    raise SystemExit('Incomplete dependency readback: ' + repr(set(names) - set(found)))\nallowed = {'propext', 'Quot.sound', 'Classical.choice'}\nfor name, axioms in found.items():\n    if not axioms <= allowed:\n        raise SystemExit('Unexpected axiom in ' + name + ': ' + repr(axioms))\nruntime = ['a', 'v', 'b', 'child', 'upperClause', 'lowerClause', 'constraints']\nfor name in runtime:\n    if 'Classical.choice' in found['Subtail.TerminalRealization.' + name]:\n        raise SystemExit('Classical.choice in executable constructor ' + name)\nprint(json.dumps({'status': 'PASS', 'declarations': len(names),\n                  'source_sha256': hashes, 'constructor_choice_free': True}, indent=2))\nPY\n",
        "cwd": "lean",
        "returncode": 0,
