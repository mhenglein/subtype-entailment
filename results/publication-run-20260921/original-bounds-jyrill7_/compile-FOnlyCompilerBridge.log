theorem Subtail.FOnlyCompilerBridge.original_F : ∀ {k : Nat} (I : Instance k),
  TerminalRank.TerminalFinals I → ((∃ w, Witness I w) ↔ ∃ w, Witness I w ∧ List.length w ≤ originalF k) :=
fun {k} I ht =>
  { mp := terminal_witness_original_bounded I ht,
    mpr := fun x =>
      match x with
      | Exists.intro w ⟨hw, right⟩ => Exists.intro w hw }
